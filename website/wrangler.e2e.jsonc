// Local end-to-end runs only (tests/run-site.sh): the site as deployed, bound
// to the local test bridge, with no route. Its GitHub is a local fake, and its
// secrets come from the run.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "clientmcp-website-e2e",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"d1_databases": [
		{
			"binding": "SITE_DB",
			"database_name": "clientmcp-site-e2e",
			"database_id": "00000000-0000-0000-0000-0000000000e2",
			"migrations_dir": "migrations"
		}
	],
	"services": [{ "binding": "BRIDGE", "service": "clientmcp-selfserve-test" }],
	"vars": { "ADMIN_GITHUB_ID": "1001" }
}
