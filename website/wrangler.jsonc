{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "clientmcp-website",
	"compatibility_date": "2026-10-20",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "clientmcp.dev", "custom_domain": true }],
	"workers_dev": true,
	"preview_urls": true,
	// Self-serve tokens (docs/self-serve.md). Secrets, set with `wrangler
	// secret put`: SERVICE_SECRET (the bridge's CLIENTMCP_SERVICE_SECRET),
	// GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, SESSION_KEY. The site never holds
	// the token secret: the bridge signs.
	"d1_databases": [
		{
			"binding": "SITE_DB",
			"database_name": "clientmcp-site",
			// Created at the site's first production deploy with these.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"services": [{ "binding": "BRIDGE", "service": "clientmcp" }],
	"vars": {
		"BRIDGE_PUBLIC_URL": "wss://bridge.clientmcp.dev/connect",
		"ADMIN_GITHUB_ID": "113176571"
	},
	"env": {
		// staging.clientmcp.dev, against the staging bridge, with its own
		// database and its own GitHub OAuth app.
		"staging": {
			"name": "clientmcp-website-staging",
			"routes": [{ "pattern": "staging.clientmcp.dev", "custom_domain": true }],
			"workers_dev": false,
			"preview_urls": false,
			"d1_databases": [
				{
					"binding": "SITE_DB",
					"database_name": "clientmcp-site-staging",
					"database_id": "e04e1f23-f0da-4f54-8964-38bc46a7fb52",
					"migrations_dir": "migrations"
				}
			],
			"services": [{ "binding": "BRIDGE", "service": "clientmcp-staging" }],
			"vars": {
				"BRIDGE_PUBLIC_URL": "wss://bridge-staging.clientmcp.dev/connect",
				"ADMIN_GITHUB_ID": "113176571",
				// A wallet's local development server may exchange codes (never in production).
				"TOKEN_CORS_LOOPBACK": "1"
			}
		}
	}
}
